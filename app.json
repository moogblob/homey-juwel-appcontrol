      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "id": "poll_interval",
          "type": "number",
          "label": {
            "en": "Refresh interval"
          },
          "hint": {
            "en": "How often Homey asks the MyJUWEL cloud for the feeder's state, in seconds."
          },
          "value": 30,
          "min": 10,
          "max": 3600,
          "units": {
            "en": "s"
          }
        }
      ],
      "id": "smartfeed"
    }
  ],
