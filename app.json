{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.github.moogblob.juwel-appcontrol",
  "version": "1.0.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local",
    "cloud"
  ],
  "name": {
    "en": "JUWEL AppControl"
  },
  "description": {
    "en": "Control your JUWEL HeliaLux, JUWEL SmartFeed and JUWEL EccoFlow"
  },
  "author": {
    "name": "Johan Klintberg",
    "email": "johan.klintberg@gmail.com"
  },
  "support": "https://github.com/moogblob/homey-juwel-appcontrol/issues",
  "source": "https://github.com/moogblob/homey-juwel-appcontrol",
  "bugs": {
    "url": "https://github.com/moogblob/homey-juwel-appcontrol/issues"
  },
  "category": [
    "appliances"
  ],
  "brandColor": "#0069B4",
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "esm": true,
  "flow": {
    "actions": [
      {
        "id": "eccoflow_set_mode",
        "title": {
          "en": "Set operating mode"
        },
        "titleFormatted": {
          "en": "Set operating mode to [[mode]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=eccoflow"
          },
          {
            "type": "autocomplete",
            "name": "mode",
            "placeholder": {
              "en": "Mode"
            },
            "title": {
              "en": "Mode"
            }
          }
        ]
      },
      {
        "id": "eccoflow_reset_timer",
        "title": {
          "en": "Reset maintenance timer"
        },
        "titleFormatted": {
          "en": "Reset the [[timer]] timer"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=eccoflow"
          },
          {
            "type": "autocomplete",
            "name": "timer",
            "placeholder": {
              "en": "Timer"
            },
            "title": {
              "en": "Timer"
            }
          }
        ]
      },
      {
        "id": "smartfeed_feed_default",
        "title": {
          "en": "Feed now"
        },
        "hint": {
          "en": "Feeds the quantity set on the feeder."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=smartfeed"
          }
        ]
      },
      {
        "id": "smartfeed_feed",
        "title": {
          "en": "Feed an amount now"
        },
        "titleFormatted": {
          "en": "Feed [[amount]] now"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=smartfeed"
          },
          {
            "type": "number",
            "name": "amount",
            "min": 1,
            "max": 8,
            "step": 1,
            "placeholder": {
              "en": "Amount (1-8)"
            },
            "title": {
              "en": "Amount"
            }
          }
        ]
      }
    ],
    "triggers": [
      {
        "id": "smartfeed_fed",
        "title": {
          "en": "Fish were fed"
        },
        "hint": {
          "en": "Fires when the feeder reports a new feeding, whether from Homey, its feeding plan or its own button. Noticed at the next refresh."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=smartfeed"
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "EccoFlow"
      },
      "class": "other",
      "capabilities": [
        "onoff",
        "juwel_flow_rate",
        "juwel_pump_mode",
        "onoff.smart_feed",
        "onoff.power_limit"
      ],
      "capabilitiesOptions": {
        "onoff": {
          "title": {
            "en": "On/off"
          }
        },
        "onoff.smart_feed": {
          "title": {
            "en": "Feeding pause"
          }
        },
        "onoff.power_limit": {
          "title": {
            "en": "Power limit"
          }
        }
      },
      "platforms": [
        "local",
        "cloud"
      ],
      "connectivity": [
        "cloud"
      ],
      "images": {
        "small": "/drivers/eccoflow/assets/images/small.png",
        "large": "/drivers/eccoflow/assets/images/large.png",
        "xlarge": "/drivers/eccoflow/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "id": "poll_interval",
          "type": "number",
          "label": {
            "en": "Refresh interval"
          },
          "hint": {
            "en": "How often Homey asks the MyJUWEL cloud for the pump's state, in seconds."
          },
          "value": 30,
          "min": 10,
          "max": 3600,
          "units": {
            "en": "s"
          }
        }
      ],
      "id": "eccoflow"
    },
    {
      "name": {
        "en": "HeliaLux"
      },
      "class": "light",
      "capabilities": [
        "onoff",
        "dim",
