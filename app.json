    {
      "name": {
        "en": "SmartFeed"
      },
      "class": "other",
      "capabilities": [
        "juwel_feed",
        "juwel_feed_quantity",
        "juwel_feed_key_quantity",
        "onoff",
        "onoff.led",
        "alarm_generic.chamber_empty",
